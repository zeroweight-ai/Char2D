# Copy to .env.local. Keys remain on the server.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_CHAT_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0
CHAR2D_DATA_DIR=./data
CHAR2D_MAX_PARALLEL_IMAGE_JOBS=2
# Set to 0 to use Muse. Fake mode works without an API key.
CHAR2D_FAKE_AI=1

# ElevenLabs sound effects for moves (ELEVENLABS_API_KEY also works).
# Without a key (and with fake AI off) moves are silent.
ELEVENLAB_API_KEY=
